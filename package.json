{
  "name": "grokbot-austin",
  "version": "1.0.0",
  "private": true,
  "description": "Grok Bot Austin GTM build night — bot-to-bot badge booth with auto-print to a Phomemo M110",
  "homepage": "https://grokbotaustin.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/mehh/grokbot-austin"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "print-agent": "bash print-agent/run.sh",
    "print-agent:setup": "bash -c \"cd print-agent && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt\""
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@upstash/redis": "^1.38.4",
    "next": "^15.5.25",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-bluetooth": "^0.0.21",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
