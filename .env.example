# Public URL of the deployed booth (used for QR codes, bot prompt, badge links)
NEXT_PUBLIC_BASE_URL=https://grokbotaustin.vercel.app

# BLE name / serial of the booth's Phomemo M110. Used by the /booth Web Bluetooth fallback
# to prefer this device in the chooser and on reconnect.
NEXT_PUBLIC_PHOMEMO_NAME=q450E5CQ7550085

# Shared secret for bots + the print agent (header: x-booth-token)
BOOTH_TOKEN=austin-gtm-2026

# HMAC secret used to sign badge ids. Change in production.
BADGE_SECRET=change-me-before-the-party

# Optional: separate token for queue control (pause/reprint/agent). Falls back to BOOTH_TOKEN.
# ADMIN_TOKEN=

# Optional: durable queue via Upstash Redis (Vercel Marketplace -> Upstash).
# Without these the queue lives in-memory in the serverless instance.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# or
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- print-agent (Kris's MacBook) ---
# BOOTH_URL=https://grokbotaustin.vercel.app
# BOOTH_TOKEN=austin-gtm-2026
# PHOMEMO_ADDR=q450E5CQ7550085

# Optional: fire-and-forget POST on every claim (JSON: name, botName, handshake, hostReply, previewUrl, jobId, short).
# Point at a Grok Bot / Chaos Concierge webhook routine to log bot-to-bot theater in chat. Does not block claim.
# BOOTH_PING_URL=https://example.com/hooks/booth-claim
# BOOTH_PING_SECRET=  # Bearer + X-Automation-Key; both URL and SECRET required to ping
