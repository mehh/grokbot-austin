# Public URL of the deployed booth (used for QR codes, bot prompt, badge links)
NEXT_PUBLIC_BASE_URL=https://grokbotaustin.vercel.app

# Shared secret for bots + the print agent (header: x-booth-token)
BOOTH_TOKEN=austin-gtm-2026

# HMAC secret used to sign badge ids. Change in production.
BADGE_SECRET=change-me-before-the-party

# Optional: durable queue via Upstash Redis (Vercel Marketplace -> Upstash).
# Without these the queue lives in-memory in the serverless instance.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# or
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

